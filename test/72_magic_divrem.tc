int seed = -97;

void keep_seed_mutable(int value) {
  seed = value;
}

int main() {
  int i = 0;
  int sum = seed / 3 + seed % 3;
  while (i < 100) {
    int value = i - 50;
    sum = sum + value / 3 + value % 3;
    sum = sum + value / -5 + value % -5;
    sum = sum + value / 7 + value % 7;
    sum = sum + value / 1000 + value % 1000;
    i = i + 1;
  }
  return sum;
}
